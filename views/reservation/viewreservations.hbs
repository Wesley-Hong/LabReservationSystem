<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Reservations</title>
  <link rel="stylesheet" href="/css/viewreservationsstyle.css">
</head>
<body>

<h1>Reservations</h1>

<div id="reservationsContainer">

{{#each reservations}}

<div class="reservation-container">

<button class="edit-btn" onclick="window.location.href='/reservation/editReservation/{{this._id}}'">Edit</button>
<button class="cancel-btn" onclick="cancelReservation('{{this._id}}', this)">Cancel</button>

<p><strong>Seat Number:</strong> {{this.seatNumber}}</p>
<p><strong>Laboratory:</strong> {{this.lab.labNum}}</p>
<p><strong>Date & Time Requested:</strong> {{this.requestDateTime}}</p>
<p><strong>Reservation Date:</strong> {{this.reservationDate}}</p>
<p><strong>Reservation Time:</strong> {{this.timeStart}} - {{this.timeEnd}}</p>
<p><strong>Reserved By:</strong>
{{#if this.isAnonymous}}
Anonymous
{{else}}
<a href="/profile/{{this.ReservedUnder._id}}">
{{this.ReservedUnder.firstName}} {{this.ReservedUnder.lastName}}
</a>
{{/if}}
</p>

</div>

{{else}}

<p>No reservations found.</p>

{{/each}}

</div>

<a id="BackToHome" href="/home">&lt- Back To Home</a>

</body>
</html>
