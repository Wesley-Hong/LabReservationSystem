<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Reservations</title>
  <link rel="stylesheet" href="/css/viewreservationsstyle.css">
</head>
<body>

<h1>Reservations</h1>

<div id="reservationsContainer">

<!-- HARDCODED RESERVATION FOR DEMO -->
<div class="reservation-container">
<button class="edit-btn" onclick="window.location.href='/reservation/editReservation'">
Edit
</button>
<p><strong>Seat Number:</strong> 4</p>
<p><strong>Laboratory:</strong> Computer Lab 01</p>
<p><strong>Date & Time Requested:</strong> 2026-03-13 10:00 AM</p>
<p><strong>Reservation Date:</strong> 2026-03-20</p>
<p><strong>Reservation Time:</strong> 10:00AM - 10:30AM</p>
</div>

{{#each reservations}}

<div class="reservation-container">

<button class="edit-btn" onclick="window.location.href='/reservation/editReservation?id={{this._id}}'">
Edit
</button>

<p><strong>Seat Number:</strong> {{this.seatNumber}}</p>
<p><strong>Laboratory:</strong> {{this.lab.labNum}}</p>
<p><strong>Date & Time Requested:</strong> {{this.requestDateTime}}</p>
<p><strong>Reservation Date:</strong> {{this.reservationDate}}</p>
<p><strong>Reservation Time:</strong> {{this.timeStart}} - {{this.timeEnd}}</p>

</div>

{{else}}

<p>No reservations found.</p>

{{/each}}

</div>

<a id="BackToHome" href="/home">&lt- Back To Home</a>

</body>
</html>