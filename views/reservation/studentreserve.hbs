    <script>
        // Declarations for Computer Lab buttons, chosen lab paragraph
        const buttonlab1 = document.getElementById("ComputerLab1");
        const buttonlab2 = document.getElementById("ComputerLab2");
        const buttonlab3 = document.getElementById("ComputerLab3");
        const computerLabParagraph = document.getElementById("ComputerLab");
        
        const slotsTakenArray = [];

        // Declaration for submit button
        const submitButton = document.getElementById("submit");
        submitButton.disabled = true;

        // helper variable to store which lab button clicked
        var labChosen = 0;

        const checkboxes = document.querySelectorAll(".timeslot");
        
        // Formatting of chosen lab paragraph
        computerLabParagraph.style.fontWeight = "bold";
        computerLabParagraph.style.fontSize = "20px";
        
        // Constructor function for reservation data
        function Reservation(lab, date, timeslots, anonymous) {
            this.lab = lab;
            this.date = date;
            this.timeslots = timeslots;
            this.anonymous = anonymous;
        }

        // Constructor function for slots taken in a laboratory at a specific date and timeslot
        function Slot(computerLab, date, timeslot, slotsTaken) {
            this.computerLab = computerLab;
            this.date = date;
            this.timeslot = timeslot;
            this.slotsTaken = slotsTaken;
        }

        // Event listeners for computer lab buttons to set chosen lab and enable submit button
        buttonlab1.addEventListener("click", function(){
            labChosen = 1;
            submitButton.disabled = false;
            computerLabParagraph.textContent ="Chosen Lab: Computer Laboratory 1";

            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });

            reservations.forEach(reservation => {
                if (dateInput.value === reservation.date && labChosen === reservation.lab) {
                    slotsTakenArray.forEach(slot => {
                            reservation.timeslots.forEach(timeslot => {
                            if (slot.computerLab === reservation.lab && slot.date === reservation.date && timeslot === slot.timeslot) {
                                if (slot.slotsTaken >= 12) {
                                    const checkbox = document.getElementById(timeslot);
                                    if (checkbox) {
                                        checkbox.disabled = true;
                                        const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                        if (slotsLeftSpan) {
                                            slotsLeftSpan.textContent = `0 slots left`;
                                        }
                                    }                                 
                                }
                                else {
                                    const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                    if (slotsLeftSpan) {
                                        slotsLeftSpan.textContent = `${12 - slot.slotsTaken} slots left`;
                                    }
                                }
                            }
                        });
                    })
                }
            });
        })

        buttonlab2.addEventListener("click", function(){
            labChosen = 2;
            submitButton.disabled = false;
            computerLabParagraph.textContent ="Chosen Lab: Computer Laboratory 2";

            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });

            reservations.forEach(reservation => {
                if (dateInput.value === reservation.date && labChosen === reservation.lab) {
                    slotsTakenArray.forEach(slot => {
                            reservation.timeslots.forEach(timeslot => {
                            if (slot.computerLab === reservation.lab && slot.date === reservation.date && timeslot === slot.timeslot) {
                                if (slot.slotsTaken >= 12) {
                                    const checkbox = document.getElementById(timeslot);
                                    if (checkbox) {
                                        checkbox.disabled = true;
                                        const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                        if (slotsLeftSpan) {
                                            slotsLeftSpan.textContent = `0 slots left`;
                                        }
                                    }                                 
                                }
                                else {
                                    const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                    if (slotsLeftSpan) {
                                        slotsLeftSpan.textContent = `${12 - slot.slotsTaken} slots left`;
                                    }
                                }
                            }
                        });
                    })
                }
            });
        })

        buttonlab3.addEventListener("click", function(){
            labChosen = 3;
            submitButton.disabled = false;
            computerLabParagraph.textContent ="Chosen Lab: Computer Laboratory 3";

            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });

            reservations.forEach(reservation => {
                if (dateInput.value === reservation.date && labChosen === reservation.lab) {
                    slotsTakenArray.forEach(slot => {
                            reservation.timeslots.forEach(timeslot => {
                            if (slot.computerLab === reservation.lab && slot.date === reservation.date && timeslot === slot.timeslot) {
                                if (slot.slotsTaken >= 12) {
                                    const checkbox = document.getElementById(timeslot);
                                    if (checkbox) {
                                        checkbox.disabled = true;
                                        const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                        if (slotsLeftSpan) {
                                            slotsLeftSpan.textContent = `0 slots left`;
                                        }
                                    }                                 
                                }
                                else {
                                    const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                    if (slotsLeftSpan) {
                                        slotsLeftSpan.textContent = `${12 - slot.slotsTaken} slots left`;
                                    }
                                }
                            }
                        });
                    })
                }
            });
        })

        // Declaration for date input
        const dateInput = document.getElementById("reserve_date");

        // default date to today
        const today = new Date().toISOString().split("T")[0];

        // 7 day range
        const maxDate = new Date();
        maxDate.setDate(maxDate.getDate() + 6);
        dateInput.min = today;
        dateInput.max = maxDate.toISOString().split("T")[0];

        // Declaration for reservation form
        const reservationForm = document.getElementById("reservationform");
        
        // Array to store reservation data objects
        const reservations = []; 

        // Event listener for form submission to create reservation data object and store it in the array
        reservationForm.addEventListener("submit", function(event) {
            event.preventDefault(); // prevent page refresh

            const selectedLab = computerLabParagraph.textContent;
            const selectedDate = dateInput.value;

            // query selector returns a NodeList, so we convert it to an array to easily map the values
            const selectedTimeslots = Array.from(document.querySelectorAll(".timeslot:checked")).map(input => input.value);
            
            // *.checked* returns true if the checkbox is checked, false otherwise
            const isAnonymous = document.getElementById("reserve_anonymous").checked;

            // TESTING
            console.log("Selected Lab:", selectedLab);
            console.log("Selected Date:", selectedDate);
            console.log("Selected Timeslots:", selectedTimeslots);
            console.log("Reserve Anonymously:", isAnonymous);

            // create reservation data object and store it in the array
            const reservationData = new Reservation(selectedLab, selectedDate, selectedTimeslots, isAnonymous);
            reservations.push(reservationData);
            
            var slotFound = false;
            
            selectedTimeslots.forEach(timeslot => {   
                slotFound = false;         
                slotsTakenArray.forEach(slot => {
                    if (slot.computerLab === selectedLab && slot.date === selectedDate && timeslot === slot.timeslot) {
                        slot.slotsTaken += 1;
                        slotFound = true;
                    }
                });

                if (!slotFound) {
                    const slotTaken = new Slot(selectedLab, selectedDate, timeslot, 1);
                    slotsTakenArray.push(slotTaken);
                    console.log("Slot Taken Object:", slotTaken);
                }
            });

            // TESTING
            console.log("Reservation Data Object:", reservationData);
            console.log("Slots Taken Array:", slotsTakenArray);

            alert("Reservation submitted successfully!");
            document.getElementById("reservationform").reset();
        });
        
        dateInput.addEventListener("change", function() {
            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });
            reservations.forEach(reservation => {
                if (dateInput.value === reservation.date && labChosen === reservation.lab) {
                    slotsTakenArray.forEach(slot => {
                            reservation.timeslots.forEach(timeslot => {
                            if (slot.computerLab === reservation.lab && slot.date === reservation.date && timeslot === slot.timeslot) {
                                if (slot.slotsTaken >= 12) {
                                    const checkbox = document.getElementById(timeslot);
                                    if (checkbox) {
                                        checkbox.disabled = true;
                                        const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                        if (slotsLeftSpan) {
                                            slotsLeftSpan.textContent = `0 slots left`;
                                        }
                                    }                                 
                                }
                                else {
                                    const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                    if (slotsLeftSpan) {
                                        slotsLeftSpan.textContent = `${12 - slot.slotsTaken} slots left`;
                                    }
                                }
                            }
                        });
                    })
                }
            });
        });

        var modal = document.getElementById("myModal");
        var seats = document.querySelectorAll(".labSeat");
        var closeModal = document.getElementsByClassName("close")[0];
        
        checkboxes.forEach(checkbox => {
            checkbox.addEventListener("change", function(event) {
                if (event.target.checked) {
                    modal.style.display = "block";
                }

                else if (!event.target.checked) {
                    seats.forEach(seat => {
                        seat.checked = false;
                    });
                }

                updateModalHeading(checkbox.value);
            });
        });


        closeModal.onclick = function() {
            modal.style.display = "none";
        }
        
        function updateModalHeading(timeslot) {
            const modalHeader = document.getElementById("modalHeader");
            modalHeader.textContent = `SEAT SELECTION - ${timeslot}`;
        }

        

    </script>
