    reservationForm.addEventListener("submit", async function(event) {
        event.preventDefault(); 

        // Gather data from existing UI variables
        const reservationData = {
            lab: `Computer Lab ${labChosen}`, // Formats it for the DB
            date: dateInput.value,
            // Get the selected timeslot
            timeslot: Array.from(document.querySelectorAll(".timeslot:checked")).map(i => i.value)[0],
            // Get the selected seat from the modal
            seatNumber: Array.from(document.querySelectorAll(".labSeat:checked")).map(i => i.value)[0]
        };

        // Basic Validation
        if (!reservationData.timeslot || !reservationData.seatNumber) {
            alert("Please select both a timeslot and a seat!");
            return;
        }

        try {
            const response = await fetch('/reservation/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(reservationData)
            });

            if (response.ok) {
                alert("Reservation Saved to Database!");
                window.location.href = "/reservation/viewReservations"; 
            } else {
                alert("Error: Seat might already be taken.");
            }
        } catch (err) {
            console.error("Submission error:", err);
        }
    });
        
        dateInput.addEventListener("change", function() {
            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });

            refreshTakenSeats();

            reservations.forEach(reservation => {
                if (dateInput.value === reservation.date && labChosen === reservation.lab) {
                    slotsTakenArray.forEach(slot => {
                            reservation.timeslots.forEach(timeslot => {
                            if (slot.computerLab === reservation.lab && slot.date === reservation.date && timeslot === slot.timeslot) {
                                if (slot.slotsTaken >= 12) {
                                    const checkbox = document.getElementById(timeslot);
                                    if (checkbox) {
                                        checkbox.disabled = true;
                                        const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                        if (slotsLeftSpan) {
                                            slotsLeftSpan.textContent = `0 slots left`;
                                        }
                                    }                                 
                                }
                                else {
                                    const slotsLeftSpan = document.getElementById(timeslot + "-slots");
                                    if (slotsLeftSpan) {
                                        slotsLeftSpan.textContent = `${12 - slot.slotsTaken} slots left`;
                                    }
                                }
                            }
                        });
                    })
                }
            });
        });

        var modal = document.getElementById("myModal");
        var seats = document.querySelectorAll(".labSeat");
        var closeModal = document.getElementsByClassName("close")[0];
        
        checkboxes.forEach(checkbox => {
            checkbox.addEventListener("change", function(event) {
                if (event.target.checked) {
                    modal.style.display = "block";
                }

                else if (!event.target.checked) {
                    seats.forEach(seat => {
                        seat.checked = false;
                    });
                }

                updateModalHeading(checkbox.value);
            });
        });


        closeModal.onclick = function() {
            modal.style.display = "none";
        }
        
        function updateModalHeading(timeslot) {
            const modalHeader = document.getElementById("modalHeader");
            modalHeader.textContent = `SEAT SELECTION - ${timeslot}`;
        }

        

    </script>
