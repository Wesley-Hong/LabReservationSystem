<!DOCTYPE html>

<html >
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link rel="stylesheet" href="/css/profilestyle.css">
</head>

<body>

    <div class="container">
        <div class="nav">
            <a href="/user/profile?email={{user.email}}" class="back">Back</a>
        </div>

        <form action="/user/update_profile" method="POST">
            <input type="hidden" name="originalEmail" value="{{user.email}}">

        <div class="profile">
             <div class="prof_pic"><img src="/images/{{user.profilePicture}}" alt="Profile Picture"></div>
            <div class="info">
                <h1>{{user.firstName}} {{user.lastName}}</h1>
                <h2>{{user.email}}</h2>

                <div class="role"> 
                    <h3>{{user.role}}</h3>
                </div>
            </div>
            <button type="button" class="editPic">Edit Profile Picture</button>
        </div>

        <div class="description">
            <textarea id="description" name="description" rows="3" cols="80">{{user.description}}</textarea>
        </div>

    <div class="edit">
        <h4>Edit Profile Information</h4>
        
        <div class="name">
            <div class="first_name">
                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="firstName" value="{{user.firstName}}">
                <div class="error" id="first_name_error"></div>                
            </div>

            <div class="last_name">
                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="lastName" value="{{user.lastName}}">
                <div class="error" id="last_name_error"></div>
            </div>
        </div>


        <div class ="email">
                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email" value="{{user.email}}">
                <div class="error" id="email_error"></div>
        </div>

        <div class="changePass">

            <div class="password">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" placeholder="leave blank to keep current password">
                <div class="error" id="password_error"></div>
            </div>
        </div>
    </div>

        <button type="submit" class="save">Save Changes</button>
        </form>
    </div>
</body>
</html>
